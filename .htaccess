# ==============================================================================
# Web Optimizer - Enterprise WAF Security, Anti-Hotlink & Clean SEO/AEO/GEO Engine
# https://www.weboptimizer.in | Founder: Hrushikesh Swain (+91 7735973818)
# ==============================================================================

# Disable Directory Listing & Server Signature
Options -Indexes
ServerSignature Off

# Protect Hidden & Internal Build Files from Public Access
<FilesMatch "(^\.|\.(env|git|htaccess|htpasswd|ini|log|sh|sql|bak)$|^build-static\.php$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# Enterprise HTTP Security Headers Against XSS, Clickjacking & MIME Injection
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=()"
  Header always unset X-Powered-By
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  DirectoryIndex index.php index.html

  # ----------------------------------------------------------------------------
  # 0. MALWARE, SQL INJECTION, XSS & HOTLINK FIREWALL (WAF)
  # ----------------------------------------------------------------------------
  # Block dangerous HTTP methods
  RewriteCond %{REQUEST_METHOD} ^(TRACE|DELETE|TRACK|PUT|PATCH) [NC]
  RewriteRule ^ - [F,L]

  # Block XSS, SQLi, File Inclusion & Base64 Shell Injections in Query Strings
  RewriteCond %{QUERY_STRING} (<|%3C).*script.*(>|%3E) [NC,OR]
  RewriteCond %{QUERY_STRING} GLOBALS(=|\[|\%[0-9A-Z]{0,2}) [OR]
  RewriteCond %{QUERY_STRING} _REQUEST(=|\[|\%[0-9A-Z]{0,2}) [OR]
  RewriteCond %{QUERY_STRING} base64_(en|de)code\(.*\) [NC,OR]
  RewriteCond %{QUERY_STRING} (union.*select|insert.*into|drop.*table|information_schema) [NC,OR]
  RewriteCond %{QUERY_STRING} (eval\(|php://|etc/passwd|boot\.ini|\.\./\.\./) [NC,OR]
  RewriteCond %{QUERY_STRING} (javascript:|vbscript:|onload=|onerror=|document\.cookie) [NC]
  RewriteRule ^ - [F,L]

  # Image Anti-Hotlink Protection (Prevent external websites from stealing images)
  RewriteCond %{HTTP_REFERER} !^$
  RewriteCond %{HTTP_REFERER} !^https?://(www\.)?weboptimizer\.in [NC]
  RewriteCond %{HTTP_REFERER} !^https?://(localhost|127\.0\.0\.1|hrushikes94\.github\.io) [NC]
  RewriteCond %{HTTP_REFERER} !^https?://(www\.)?(google\.|bing\.|facebook\.|linkedin\.|twitter\.|t\.co|whatsapp\.) [NC]
  RewriteRule \.(webp|jpg|jpeg|png|gif|svg)$ - [F,NC,L]

  # ----------------------------------------------------------------------------
  # 1. 301 Permanent Redirects (Query Strings -> Clean SEO URLs)
  # Uses %{THE_REQUEST} to prevent internal rewrite loops (Works on / and /Portfolio/)
  # ----------------------------------------------------------------------------

  # Redirect service-location.php?service=X&city=Y -> service/X/Y
  RewriteCond %{THE_REQUEST} \s/(?:Portfolio/)?service-location\.php\?service=([a-z0-9\-]+)&city=([a-z0-9\-]+)\s [NC]
  RewriteRule ^ service/%1/%2? [R=301,L]

  # Redirect service-location.php?city=Y&service=X -> service/X/Y
  RewriteCond %{THE_REQUEST} \s/(?:Portfolio/)?service-location\.php\?city=([a-z0-9\-]+)&service=([a-z0-9\-]+)\s [NC]
  RewriteRule ^ service/%2/%1? [R=301,L]

  # Redirect location.php?city=X -> location/X
  RewriteCond %{THE_REQUEST} \s/(?:Portfolio/)?location\.php\?city=([a-z0-9\-]+)\s [NC]
  RewriteRule ^ location/%1? [R=301,L]

  # Redirect service-detail.php?slug=X -> service/X
  RewriteCond %{THE_REQUEST} \s/(?:Portfolio/)?service-detail\.php\?slug=([a-z0-9\-]+)\s [NC]
  RewriteRule ^ service/%1? [R=301,L]

  # Redirect direct index.php -> /
  RewriteCond %{THE_REQUEST} \s/(?:Portfolio/)?index\.php[\s?] [NC]
  RewriteRule ^index\.php$ ./ [R=301,L]

  # Redirect direct master pages (services.php, locations.php, blog.php, contact.php, resume.php) -> clean URLs
  RewriteCond %{THE_REQUEST} \s/(?:Portfolio/)?(services|locations|blog|contact|resume)\.php[\s?] [NC]
  RewriteRule ^(services|locations|blog|contact|resume)\.php$ $1? [R=301,L]

  # Redirect direct standalone service .php files (except contact-submit.php, resume.php & sitemap.php) -> /service/{slug}
  RewriteCond %{THE_REQUEST} \s/(?:Portfolio/)?([a-z0-9\-]+)\.php[\s?] [NC]
  RewriteCond %{REQUEST_URI} !/(index|services|locations|location|service-detail|service-location|blog|blog-post|contact|contact-submit|resume|sitemap|build-static)\.php$ [NC]
  RewriteRule ^([a-z0-9\-]+)\.php$ service/$1? [R=301,L]

  # ----------------------------------------------------------------------------
  # Retired Services 301 Permanent Redirects
  # ----------------------------------------------------------------------------
  RewriteRule ^(production-content|video-production|commercial-photography|audio-production)(\.php)?/?$ services [R=301,L]

  # ----------------------------------------------------------------------------
  # 2. Dynamic XML Sitemap Rewrite
  # ----------------------------------------------------------------------------
  RewriteRule ^sitemap\.xml$ sitemap.php [L]

  # ----------------------------------------------------------------------------
  # 3. Clean Master Directories, Contact Us, Unlisted Resume & Blog Knowledge Hub
  # ----------------------------------------------------------------------------
  RewriteRule ^locations/?$ locations.php [L,QSA]
  RewriteRule ^services/?$ services.php [L,QSA]
  RewriteRule ^contact/?$ contact.php [L,QSA]
  RewriteRule ^contact-us/?$ contact.php [L,QSA]
  RewriteRule ^resume/?$ resume.php [L,QSA]
  RewriteRule ^blog/?$ blog.php [L,QSA]
  RewriteRule ^blogs/?$ blog.php [L,QSA]
  RewriteRule ^blog/([a-z0-9\-]+)/?$ blog-post.php?slug=$1 [L,QSA]

  # ----------------------------------------------------------------------------
  # 4. Programmatic Service + Location SEO Landing Pages
  # Pattern A (Hierarchical): /service/{service}/{city}
  # Example: /service/technical-seo/paradeep
  # ----------------------------------------------------------------------------
  RewriteRule ^service/([a-z0-9\-]+)/([a-z0-9\-]+)/?$ service-location.php?service=$1&city=$2 [L,QSA]

  # Pattern B (Keyword-Rich Local SEO): /{service}-in-{city}
  # Example: /technical-seo-in-paradeep
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^([a-z0-9\-]+)-in-([a-z0-9\-]+)/?$ service-location.php?service=$1&city=$2 [L,QSA]

  # ----------------------------------------------------------------------------
  # 5. City Hub Landing Pages (50 Odisha Locations)
  # Example: /location/paradeep, /location/bhubaneswar, /location/cuttack
  # ----------------------------------------------------------------------------
  RewriteRule ^location/([a-z0-9\-]+)/?$ location.php?city=$1 [L,QSA]

  # ----------------------------------------------------------------------------
  # 6. Service Detail / Category Hub Dynamic Pages
  # Example: /service/technical-seo, /services/technical-seo
  # ----------------------------------------------------------------------------
  RewriteRule ^service/([a-z0-9\-]+)/?$ service-detail.php?slug=$1 [L,QSA]
  RewriteRule ^services/([a-z0-9\-]+)/?$ service-detail.php?slug=$1 [L,QSA]

  # ----------------------------------------------------------------------------
  # 7. Extensionless PHP Fallback
  # Example: /digital-marketing -> digital-marketing.php
  # ----------------------------------------------------------------------------
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.php -f
  RewriteRule ^([^\.]+)$ $1.php [NC,L]

</IfModule>
